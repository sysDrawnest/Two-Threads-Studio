// Two Threads Studio — Prisma Schema
// Phase 5C: Trust & Risk Management Engine

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum Role {
  CUSTOMER
  ADMIN
}

enum ProductStatus {
  DRAFT
  ACTIVE
  HIDDEN
  ARCHIVED
  OUT_OF_STOCK
}

enum ProductType {
  PHYSICAL
  DIGITAL
  WORKSHOP
  SERVICE
}

enum BadgeType {
  NEW
  BEST_SELLER
  LIMITED
  EDITORS_CHOICE
  TRENDING
}

enum DifficultyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum OrderStatus {
  PENDING
  AWAITING_PAYMENT
  CONFIRMED
  PROCESSING
  HANDCRAFTING
  QUALITY_CHECK
  READY_TO_SHIP
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  RETURN_REQUESTED
  RETURNED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  CANCELLED
}

enum ShipmentStatus {
  // Active forward lifecycle
  PENDING
  PACKING
  READY_TO_SHIP
  PICKUP_SCHEDULED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  // Exception states
  FAILED_DELIVERY
  CANCELLED
  // Return lifecycle
  RETURN_REQUESTED
  RETURN_PICKED_UP
  RETURN_IN_TRANSIT
  RETURN_RECEIVED
  // Legacy aliases (kept for migration safety)
  READY
  SHIPPED
  RETURNED
}

enum PaymentMethod {
  ONLINE
  COD
  BANK_TRANSFER
}

enum AuditAction {
  ORDER_CREATED
  ORDER_UPDATED
  ORDER_CANCELLED
  STATUS_CHANGED
  INVOICE_VIEWED
  PAYMENT_CAPTURED
  PAYMENT_FAILED
  REFUND_INITIATED
  REFUND_PROCESSED
  REFUND_FAILED
  REFUND_OVERRIDDEN
  SHIPMENT_CREATED
  SHIPMENT_PICKUP_SCHEDULED
  SHIPMENT_PICKED_UP
  SHIPMENT_CANCELLED
  SHIPMENT_DELIVERED
  RETURN_SHIPMENT_CREATED
  // Phase 5C
  RISK_EVALUATED
  TRUST_SCORE_UPDATED
  ORDER_FLAGGED
  ORDER_REVIEWED
  OTP_SENT
  OTP_VERIFIED
  COD_BLOCKED
}

enum AuditActorType {
  CUSTOMER
  ADMIN
  SYSTEM
}

enum CouponType {
  PERCENTAGE
  FIXED
  FREE_SHIPPING
}

// Phase 5C enums

enum RiskDecision {
  APPROVED
  REQUIRES_OTP
  MANUAL_REVIEW
  PREPAID_ONLY
  BLOCKED
}

enum FraudFlagType {
  MULTIPLE_FAILED_PAYMENTS
  MULTIPLE_ACCOUNTS_SAME_PHONE
  MULTIPLE_ACCOUNTS_SAME_ADDRESS
  DISPOSABLE_EMAIL
  TOO_MANY_ORDERS_TODAY
  ADDRESS_MISMATCH
  CHARGEBACK_HISTORY
  REPEATED_CANCELLATIONS
  SUSPICIOUS_PATTERN
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  HIDDEN
}

enum OtpPurpose {
  FIRST_ORDER_VERIFICATION
  COD_VERIFICATION
  HIGH_VALUE_ORDER
  PHONE_CHANGE
  PHONE_REGISTRATION
}

enum ReturnEligibility {
  FULL_RETURN
  EXCHANGE_ONLY
  NO_RETURN
}

// ─────────────────────────────────────────────
// Returns Engine Enums
// ─────────────────────────────────────────────

/// Full Amazon-style return lifecycle
enum ReturnStatus {
  REQUESTED
  APPROVED
  PICKUP_SCHEDULED
  PICKED_UP
  IN_TRANSIT
  RECEIVED
  INSPECTION_PENDING
  INSPECTION_PASSED
  INSPECTION_FAILED
  REFUND_PROCESSING
  REFUNDED
  REJECTED
  CLOSED
}

/// Standardised return reasons — drives analytics
enum ReturnReason {
  DAMAGED
  WRONG_PRODUCT
  DEFECTIVE
  NOT_AS_DESCRIBED
  SIZE_ISSUE
  COLOR_DIFFERENCE
  QUALITY_ISSUE
  MISSING_PARTS
  CHANGED_MIND
  OTHER
}

/// What happens to the physical item at the warehouse
enum ReturnDisposition {
  RESTOCK
  DAMAGED
  REPAIR
  DISPOSE
  QUALITY_CHECK
}

/// Type of refund issued to customer
enum RefundType {
  ORIGINAL_PAYMENT
  STORE_CREDIT
  WALLET_CREDIT
  GIFT_CARD
}

/// Lifecycle of an individual refund attempt
enum RefundStatus {
  INITIATED
  PROCESSING
  PROCESSED
  FAILED
}

/// Exchange request lifecycle
enum ExchangeStatus {
  PENDING
  APPROVED
  INVENTORY_RESERVED
  AWAITING_RETURN
  RETURN_RECEIVED
  REPLACEMENT_SHIPPED
  COMPLETED
  CANCELLED
}

enum StudioProductType {
  EMBROIDERY_KIT
  DIY_KIT
  DIGITAL_PATTERN
  FINISHED_HOOP
  HOME_DECOR
  ACCESSORY
  FABRIC
  WORKSHOP
  GIFT_CARD
}

enum HomepageSection {
  HERO
  BEST_SELLERS
  NEW_ARRIVALS
  TRENDING
  FEATURED_COLLECTION
  GIFT_GUIDE
  JUST_FOR_YOU
  RECOMMENDED
  SALE_BANNER
  ARTISAN_PICKS
}

enum MediaType {
  IMAGE
  VIDEO
  YOUTUBE
  INSTAGRAM_REEL
  THREE_SIXTY
  TUTORIAL
}

// ─────────────────────────────────────────────
// Authentication Models (Phase 2)
// ─────────────────────────────────────────────

model User {
  id                   String    @id @default(cuid())
  firstName            String
  lastName             String
  email                String    @unique
  passwordHash         String
  /// Primary commerce identity — required for order fulfillment
  phone                String?
  /// True after OTP or manual verification by admin
  phoneVerified        Boolean   @default(false)
  avatarUrl            String?
  role                 Role      @default(CUSTOMER)
  isVerified           Boolean   @default(false)
  isActive             Boolean   @default(true)
  lastLogin            DateTime?

  dateOfBirth          DateTime?
  gender               String?
  profileImage         String?
  preferredLanguage    String    @default("en")
  marketingConsent     Boolean   @default(false)
  newsletterSubscribed Boolean   @default(false)
  memberSince          DateTime  @default(now())

  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  refreshTokens  RefreshToken[]
  reviews        Review[]
  wishlist       Wishlist[]
  addresses      Address[]
  cart           Cart?
  orders         Order[]
  customerRisk   CustomerRisk?
  otpVerifications OtpVerification[]
  returnRequests   ReturnRequest[]
  importJobs       ImportJob[]

  @@map("users")
}

model RefreshToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?
  deviceInfo String?
  ipAddress  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// ─────────────────────────────────────────────
// Catalog Models (Phase 3)
// ─────────────────────────────────────────────

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  image       String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products          Product[]
  secondaryProducts ProductSecondaryCategory[]

  @@index([isActive])
  @@index([sortOrder])
  @@map("categories")
}

model Collection {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  bannerImage String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products           Product[]
  additionalProducts ProductAdditionalCollection[]

  @@index([isActive])
  @@map("collections")
}

model Tag {
  id   String @id @default(cuid())
  name String
  slug String @unique

  products ProductTag[]

  @@map("tags")
}

model Product {
  id               String          @id @default(cuid())
  name             String
  slug             String          @unique
  shortDescription String?
  description      String
  sku              String?         @unique
  categoryId       String
  collectionId     String?

  price        Decimal  @db.Decimal(10, 2)
  comparePrice Decimal? @db.Decimal(10, 2)
  costPrice    Decimal? @db.Decimal(10, 2)

  stockQuantity     Int     @default(0)
  lowStockThreshold Int     @default(5)
  trackInventory    Boolean @default(true)

  status     ProductStatus   @default(DRAFT)
  type       ProductType     @default(PHYSICAL)
  difficulty DifficultyLevel?
  
  // Classification
  studioType        StudioProductType?
  homepageSections  HomepageSection[]

  // Boolean Labels (replaces single badge enum and featured)
  isFeatured        Boolean   @default(false)
  isNewArrival      Boolean   @default(false)
  isBestSeller      Boolean   @default(false)
  isLimitedEdition  Boolean   @default(false)
  isExclusive       Boolean   @default(false)
  isEcoFriendly     Boolean   @default(false)
  isDigitalDownload Boolean   @default(false)

  // Publishing
  publishedAt       DateTime?
  isVisible         Boolean   @default(true)
  sortOrder         Int       @default(0)

  // Extended content
  subtitle          String?
  productStory      String?   @db.Text
  artisanNotes      String?   @db.Text
  whatsIncluded     String?
  barcode           String?
  searchKeywords    String[]

  isHandmade              Boolean @default(true)
  isSustainable           Boolean @default(false)
  isCustomizable          Boolean @default(false)
  isPersonalizable        Boolean @default(false)
  madeToOrder             Boolean @default(false)
  estimatedProductionDays Int?
  estimatedShippingDays   Int?
  estimatedTime           String?

  materials         String[]
  materialsIncluded String[]
  technique         String?
  careInstructions  String?
  origin            String?

  weight     Float?
  dimensions Json?

  // SEO (extended)
  seoTitle       String?
  seoDescription String?
  seoKeywords    String?
  ogImageUrl     String?
  canonicalUrl   String?
  robotsMeta     String?   @default("index,follow")

  // Inventory extended
  allowBackorders   Boolean   @default(false)
  reservedQuantity  Int       @default(0)
  incomingQuantity  Int       @default(0)

  // Pricing extended
  taxClass          String?
  hsnCode           String?
  gstPercent        Decimal?  @db.Decimal(5,2)

  // Shipping extended
  shippingClass     String?
  isFreeShipping    Boolean   @default(false)
  isFragile         Boolean   @default(false)
  packageSize       String?

  /// Phase 5C: false for personalized/custom products — enforced by CodEligibilityEngine
  allowCod  Boolean @default(true)

  salesCount Int    @default(0)

  /// Shipping Engine: optional package profile for auto-filling shipment dimensions
  packageProfileId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category       Category         @relation(fields: [categoryId], references: [id])
  collection     Collection?      @relation(fields: [collectionId], references: [id])
  images         ProductImage[]
  variants       ProductVariant[]
  tags           ProductTag[]
  reviews        Review[]
  wishlist       Wishlist[]
  cartItems      CartItem[]
  returnPolicy   ReturnPolicy?
  media                 ProductMedia[]
  secondaryCategories   ProductSecondaryCategory[]
  additionalCollections ProductAdditionalCollection[]
  packageProfile PackageProfile?  @relation(fields: [packageProfileId], references: [id])

  @@index([status])
  @@index([isFeatured])
  @@index([categoryId])
  @@index([collectionId])
  @@index([price])
  @@index([createdAt(sort: Desc)])
  @@index([status, isFeatured])
  @@index([status, categoryId])
  @@index([status, isNewArrival])
  @@index([status, isBestSeller])
  @@index([status, isNewArrival, createdAt(sort: Desc)])
  @@index([status, isBestSeller, salesCount(sort: Desc)])
  @@index([status, studioType])
  @@index([salesCount(sort: Desc)])
  @@map("products")
}

model ProductMedia {
  id        String    @id @default(cuid())
  productId String
  type      MediaType @default(IMAGE)
  url       String
  thumbnail String?
  altText   String?
  caption   String?
  sortOrder Int       @default(0)
  isPrimary Boolean   @default(false)
  width     Int?
  height    Int?
  createdAt DateTime  @default(now())
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@index([productId])
  @@index([productId, isPrimary])
  @@map("product_media")
}

model ProductSecondaryCategory {
  productId  String
  categoryId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  @@id([productId, categoryId])
  @@map("product_secondary_categories")
}

model ProductAdditionalCollection {
  productId    String
  collectionId String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  @@id([productId, collectionId])
  @@map("product_additional_collections")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  altText   String?
  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)
  width     Int?
  height    Int?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([productId, sortOrder])
  @@index([productId, isPrimary])
  @@map("product_images")
}

model ProductVariant {
  id              String  @id @default(cuid())
  productId       String
  name            String
  value           String
  sku             String? @unique
  priceAdjustment Decimal @default(0) @db.Decimal(10, 2)
  stockQuantity   Int     @default(0)
  isActive        Boolean @default(true)

  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems CartItem[]

  @@index([productId])
  @@map("product_variants")
}

model ProductTag {
  productId String
  tagId     String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@map("product_tags")
}

enum ReviewMediaType {
  IMAGE
  VIDEO
}

model Review {
  id              String   @id @default(cuid())
  rating          Int
  title           String?
  comment         String
  productId       String
  userId          String
  orderId         String?
  status          ReviewStatus @default(PENDING)
  isVerified      Boolean  @default(true)
  isFeatured      Boolean  @default(false)
  isPinned        Boolean  @default(false)
  qualityRating   Int?
  packagingRating Int?
  valueRating     Int?
  easeOfUseRating Int?
  wouldRecommend  Boolean  @default(true)
  helpfulCount    Int      @default(0)
  unhelpfulCount  Int      @default(0)
  rejectionReason String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  media   ReviewMedia[]
  votes   ReviewHelpfulVote[]

  @@unique([productId, userId])
  @@index([productId])
  @@index([userId])
  @@index([rating])
  // Composite indexes for filtered queries
  @@index([productId, status])                        // getProductReviews where productId+status=APPROVED
  @@index([status, createdAt(sort: Desc)])            // admin listReviews ordered by date
  @@index([userId, updatedAt(sort: Desc)])            // getMyReviews ordered by updatedAt
  @@map("reviews")
}

model ReviewMedia {
  id           String          @id @default(cuid())
  reviewId     String
  type         ReviewMediaType
  url          String
  thumbnailUrl String?
  createdAt    DateTime        @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@map("review_media")
}

model ReviewHelpfulVote {
  id        String   @id @default(cuid())
  reviewId  String
  userId    String
  isHelpful Boolean
  createdAt DateTime @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
  @@index([reviewId])
  @@map("review_helpful_votes")
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@map("wishlists")
}

enum AddressType {
  HOME
  WORK
  STUDIO
  PARENTS
  OTHER
}

model Address {
  id                String      @id @default(cuid())
  userId            String
  fullName          String
  phone             String
  company           String?
  line1             String
  line2             String?
  city              String
  district          String?
  state             String
  country           String
  postalCode        String
  landmark          String?
  type              AddressType @default(HOME)
  label             String?     // Custom label display name
  isDefaultBilling  Boolean     @default(false)
  isDefaultShipping Boolean     @default(false)
  deletedAt         DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  shippingOrders Order[] @relation("ShippingAddress")
  billingOrders  Order[] @relation("BillingAddress")

  @@index([userId])
  @@map("addresses")
}

model Cart {
  id        String   @id @default(cuid())
  userId    String?  @unique
  guestId   String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id            String   @id @default(cuid())
  cartId        String
  productId     String
  variantId     String?
  quantity      Int
  unitPrice     Decimal  @db.Decimal(10, 2)
  productName   String
  primaryImage  String
  sku           String?
  variantName   String?
  customization Json?
  giftWrap      Boolean  @default(false)
  engravingText String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  cart    Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([cartId, productId, variantId])
  @@index([cartId])
  @@index([productId])
  @@index([cartId, createdAt(sort: Desc)])
  @@map("cart_items")
}

// ─────────────────────────────────────────────
// Order Models (Phase 5A — extended in 5B/5C)
// ─────────────────────────────────────────────

model Order {
  id          String @id @default(cuid())
  orderNumber String @unique

  userId            String
  shippingAddressId String
  billingAddressId  String

  subtotal   Decimal @db.Decimal(10, 2)
  discount   Decimal @default(0) @db.Decimal(10, 2)
  shipping   Decimal @default(0) @db.Decimal(10, 2)
  tax        Decimal @default(0) @db.Decimal(10, 2)
  grandTotal Decimal @db.Decimal(10, 2)
  currency   String  @default("INR")

  orderStatus   OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)
  paymentMethod PaymentMethod @default(ONLINE)

  notes          String?
  couponCode     String?
  couponDiscount Decimal    @default(0) @db.Decimal(10, 2)
  promotionId    String?
  couponType     CouponType?

  estimatedCompletionDate DateTime?

  // Phase 5B: payment reference
  paymentReference String?
  paidAt           DateTime?
  deliveredAt      DateTime?

  // Phase 5C: risk & trust
  riskDecision     RiskDecision?
  riskScore        Int?
  requiresReview   Boolean       @default(false)
  otpVerified      Boolean       @default(false)
  /// Prepaid discount applied as percentage (from PREPAID_DISCOUNT_PERCENT env)
  prepaidDiscountPct Decimal?    @db.Decimal(5, 2)
  prepaidDiscount    Decimal     @default(0) @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user            User    @relation(fields: [userId], references: [id])
  shippingAddress Address @relation("ShippingAddress", fields: [shippingAddressId], references: [id])
  billingAddress  Address @relation("BillingAddress", fields: [billingAddressId], references: [id])

  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  auditLogs     OrderAuditLog[]
  payment       Payment?
  shipment      Shipment?
  refunds       Refund[]
  reviewQueue   ManualReviewQueue?
  fraudFlags    FraudFlag[]
  returnRequests ReturnRequest[]

  @@index([userId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([orderStatus])
  @@index([paymentStatus])
  @@index([riskDecision])
  @@index([requiresReview])
  @@index([createdAt(sort: Desc)])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String?
  variantId String?

  productName  String
  productSlug  String
  productImage String
  sku          String?
  variantName  String?

  unitPrice Decimal @db.Decimal(10, 2)
  quantity  Int
  lineTotal Decimal @db.Decimal(10, 2)

  customization Json?
  engravingText String?
  giftWrap      Boolean @default(false)

  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  returnRequestItems ReturnRequestItem[]

  @@index([orderId])
  @@map("order_items")
}

model OrderStatusHistory {
  id             String       @id @default(cuid())
  orderId        String
  previousStatus OrderStatus?
  newStatus      OrderStatus
  changedBy      String
  note           String?
  createdAt      DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_status_history")
}

model OrderAuditLog {
  id        String         @id @default(cuid())
  orderId   String
  action    AuditAction
  actorType AuditActorType
  actorId   String
  details   Json?
  createdAt DateTime       @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_audit_logs")
}

model IdempotencyKey {
  id             String   @id @default(cuid())
  userId         String
  key            String   @unique
  requestHash    String
  responseStatus Int
  responseBody   Json
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  @@map("idempotency_keys")
}

// ─────────────────────────────────────────────
// Payment Models (Phase 5B)
// ─────────────────────────────────────────────

model Payment {
  id                String        @id @default(cuid())
  orderId           String        @unique
  provider          String        @default("RAZORPAY")

  providerOrderId   String?
  providerPaymentId String?       @unique
  providerSignature String?

  amount         Decimal @db.Decimal(10, 2)
  currency       String  @default("INR")

  status         PaymentStatus @default(PENDING)
  method         String?
  transactionFee Decimal?      @db.Decimal(10, 2)

  failureReason String?
  failureCode   String?

  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  metadata Json?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds Refund[]

  @@index([orderId])
  @@index([status])
  @@index([providerOrderId])
  @@map("payments")
}

// ─────────────────────────────────────────────
// Shipment Models (Phase 5B)
// ─────────────────────────────────────────────

model Shipment {
  id      String @id @default(cuid())
  orderId String @unique

  /// Which provider adapter created this shipment (e.g. "MOCK", "SHIPROCKET", "DELHIVERY")
  provider String @default("MOCK")

  // ─── Provider-neutral external references ─────────────────────────────────
  /// Provider's shipment identifier (Shiprocket: shipment_id, Delhivery: waybill, etc.)
  externalShipmentId  String?
  /// Provider's internal order reference (Shiprocket: order_id)
  externalOrderId     String?
  /// Air Waybill — primary tracking code shared with customer
  externalAwbNumber   String? @unique

  // ─── Courier details ───────────────────────────────────────────────────────
  trackingUrl    String?
  courierName    String?
  courierCode    String?
  shippingMethod String?   @default("STANDARD")

  // ─── Shipment status ───────────────────────────────────────────────────────
  status ShipmentStatus @default(PENDING)

  // ─── Documents ────────────────────────────────────────────────────────────
  labelUrl     String?
  invoiceUrl   String?
  manifestUrl  String?

  // ─── Costs & physical attributes ─────────────────────────────────────────
  shippingCost      Decimal? @db.Decimal(10, 2)
  /// Declared weight for booking (from PackageProfile)
  weightGrams       Int?
  /// Actual weight measured by courier at pickup (may differ)
  actualWeightGrams Int?
  dimensions        Json?    // { l: Int, b: Int, h: Int } in cm

  // ─── Scheduling ───────────────────────────────────────────────────────────
  pickupId          String?
  estimatedDelivery DateTime?
  shippedAt         DateTime?
  deliveredAt       DateTime?

  // ─── Relations ────────────────────────────────────────────────────────────
  /// Fulfillment location (workshop/studio) this was shipped from
  locationId       String?
  /// Package profile used for dimension/weight defaults
  packageProfileId String?

  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order           Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  location        FulfillmentLocation? @relation(fields: [locationId], references: [id])
  packageProfile  PackageProfile?      @relation(fields: [packageProfileId], references: [id])
  timeline        ShipmentTimeline[]

  @@index([orderId])
  @@index([status])
  @@index([externalAwbNumber])
  @@index([provider, status])
  @@map("shipments")
}

// ─────────────────────────────────────────────
// Shipping Engine Models (Phase 6)
// ─────────────────────────────────────────────

/// Append-only event log for a shipment. Every status transition is recorded here.
model ShipmentTimeline {
  id          String   @id @default(cuid())
  shipmentId  String
  /// Normalized internal status value (not provider-specific)
  status      String
  location    String?
  description String
  /// Where the event originated: WEBHOOK | ADMIN | SYSTEM | PROVIDER_POLL
  source      String   @default("SYSTEM")
  raw         Json?
  occurredAt  DateTime
  createdAt   DateTime @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
  @@index([shipmentId, occurredAt(sort: Desc)])
  @@map("shipment_timelines")
}

/// Singleton runtime configuration for the shipping engine.
/// Admin can change shipping behaviour without redeployment.
/// .env should only contain secrets (API keys).
model ShippingSettings {
  id String @id @default("singleton")

  /// Active shipping provider (must match SHIPPING_PROVIDER env unless overridden)
  provider              String  @default("mock")
  /// CHEAPEST | FASTEST | BEST_RATED | LOWEST_RTO | CUSTOM
  selectionStrategy     String  @default("CHEAPEST")
  autoAssignCourier     Boolean @default(true)
  autoSchedulePickup    Boolean @default(false)
  codEnabled            Boolean @default(true)

  /// Default package dimensions (cm) when no PackageProfile is assigned
  defaultWeightGrams Int @default(500)
  defaultLength      Int @default(20)
  defaultBreadth     Int @default(15)
  defaultHeight      Int @default(10)
  packagingExtraGrams Int @default(100)

  defaultLocationId  String?
  fragileHandlingNote String?

  updatedAt DateTime @updatedAt

  @@map("shipping_settings")
}

/// Reusable packaging templates assigned to products.
/// Shipment creation auto-populates weight and dimensions from the product's profile.
model PackageProfile {
  id   String @id @default(cuid())
  name String @unique // e.g. "Small Hoop", "Large Hoop", "DIY Kit", "Framed Art"

  defaultWeightGrams Int
  length             Int // cm
  breadth            Int // cm
  height             Int // cm

  isFragile           Boolean  @default(false)
  containsLiquid      Boolean  @default(false)
  containsBattery     Boolean  @default(false)
  requiresSignature   Boolean  @default(false)
  insuranceValue      Decimal? @db.Decimal(10, 2)

  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products  Product[]
  shipments Shipment[]

  @@map("package_profiles")
}

/// Physical dispatch origin for shipments.
/// Replaces the hardcoded SHIPPING_PICKUP_LOCATION env variable.
/// Multi-warehouse ready from day one.
model FulfillmentLocation {
  id   String @id @default(cuid())
  name String @unique // e.g. "Main Studio Workshop", "Bengaluru Dispatch Center"

  /// Provider's pickup location name/code (e.g. Shiprocket's pickup address name)
  providerCode String?

  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  pincode      String
  country      String  @default("India")
  phone        String
  email        String?

  isDefault Boolean @default(false)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shipments Shipment[]

  @@index([isDefault])
  @@index([isActive])
  @@map("fulfillment_locations")
}

// ─────────────────────────────────────────────
// Risk & Trust Models (Phase 5C)
// ─────────────────────────────────────────────

/// One record per customer. Upserted on every order event.
/// Trust score is CALCULATED from counters — never set manually (except admin override).
model CustomerRisk {
  id     String @id @default(cuid())
  userId String @unique

  // Order outcome counters (source of trust score)
  ordersPlaced      Int @default(0)
  ordersDelivered   Int @default(0)
  rtoCount          Int @default(0)
  cancelledOrders   Int @default(0)
  prepaidOrders     Int @default(0)
  codOrders         Int @default(0)
  chargebackCount   Int @default(0)
  failedPayments    Int @default(0)

  /// Computed from counters by TrustScoreEngine (0–100). Default 50 for new users.
  trustScore Int @default(50)

  /// Lifetime monetary spend in INR (Refinement #4)
  totalLifetimeSpend Decimal @default(0) @db.Decimal(12, 2)

  // Restrictions & Admin Overrides (Refinement #3)
  isBlocked            Boolean  @default(false)
  blockReason          String?
  forceCodAllowed      Boolean  @default(false)
  forcePrepaidOnly     Boolean  @default(false)
  tierOverride         String?
  adminOverrideReason  String?
  /// If set, orders above this value require MANUAL_REVIEW
  maxOrderValue        Decimal? @db.Decimal(10, 2)

  // Timestamps
  lastRiskEvaluation DateTime?
  lastOrderAt        DateTime?
  /// Admin notes visible only in admin dashboard
  adminNotes         String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([trustScore])
  @@index([isBlocked])
  @@map("customer_risk")
}

/// OTP record — hashed OTP stored, max 3 attempts, 10-minute TTL
model OtpVerification {
  id        String     @id @default(cuid())
  userId    String
  /// Phone or email the OTP was sent to
  recipient String
  purpose   OtpPurpose
  /// bcrypt-hashed OTP
  otpHash   String
  expiresAt DateTime
  verified  Boolean    @default(false)
  attempts  Int        @default(0)
  createdAt DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([recipient, purpose])
  @@map("otp_verifications")
}

/// Fraud signals detected by FraudDetector engine
model FraudFlag {
  id      String        @id @default(cuid())
  userId  String?
  orderId String?
  type    FraudFlagType
  details Json?
  resolved  Boolean  @default(false)
  resolvedBy String?
  resolvedAt DateTime?
  createdAt DateTime @default(now())

  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([orderId])
  @@index([type])
  @@index([resolved])
  @@map("fraud_flags")
}

/// Orders that need admin review before fulfillment begins
model ManualReviewQueue {
  id         String       @id @default(cuid())
  orderId    String       @unique
  /// Comma-separated human-readable reasons
  reason     String
  riskScore  Int
  status     ReviewStatus @default(PENDING)
  reviewedBy String?
  reviewedAt DateTime?
  reviewNote String?
  createdAt  DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("manual_review_queue")
}

/// Per-product return/refund rules enforced by backend
model ReturnPolicy {
  id          String            @id @default(cuid())
  productId   String            @unique
  eligibility ReturnEligibility
  windowDays  Int               @default(0)
  /// Displayed to customer if they attempt a return
  reason      String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("return_policies")
}

// ─────────────────────────────────────────────
// Studio Settings (Phase 6A)
// ─────────────────────────────────────────────

/// Single-row configuration table for all business settings.
/// Use StudioSettings.upsert({ where: { singleton: true } }) pattern.
model StudioSettings {
  id        String   @id @default(cuid())
  /// Enforced singleton: always true — ensures only one row exists
  singleton Boolean  @unique @default(true)

  // ── Company Details ───────────────────────
  companyName      String  @default("Two Threads Studio")
  companyTagline   String?
  companyEmail     String  @default("hello@twothreads.in")
  companyPhone     String?
  companyAddress   String?
  companyCity      String?
  companyState     String?
  companyCountry   String  @default("India")
  companyPincode   String?
  companyWebsite   String?

  // ── GST & Tax ─────────────────────────────
  gstNumber        String?
  gstEnabled       Boolean @default(true)
  gstPercent       Decimal @default(0) @db.Decimal(5, 2)
  /// "inclusive" = price includes GST | "exclusive" = GST added on top
  gstMode          String  @default("inclusive")
  hsnCode          String?

  // ── Invoice Settings ──────────────────────
  invoicePrefix    String  @default("INV")
  invoiceFooter    String?
  invoiceLogo      String?

  // ── Shipping Configuration ────────────────
  freeShippingThreshold  Decimal  @default(500) @db.Decimal(10, 2)
  standardShippingCharge Decimal  @default(60)  @db.Decimal(10, 2)
  expressShippingCharge  Decimal  @default(150) @db.Decimal(10, 2)
  shippingEnabled        Boolean  @default(true)
  shippingNote           String?

  // ── COD Rules & Feature Flags (COD Policy 2.0) ─────────
  codEnabled             Boolean  @default(true)
  codMaxOrderValue       Decimal  @default(5000) @db.Decimal(10, 2)
  codExtraCharge         Decimal  @default(0)    @db.Decimal(10, 2)
  prepaidDiscountPercent Decimal  @default(5)    @db.Decimal(5, 2)

  // Dynamic Tier Limits
  firstOrderCodLimit      Decimal @default(2000)  @db.Decimal(10, 2)
  trustedCustomerCodLimit Decimal @default(5000)  @db.Decimal(10, 2)
  loyalCustomerCodLimit   Decimal @default(10000) @db.Decimal(10, 2)
  vipCustomerCodLimit     Decimal @default(25000) @db.Decimal(10, 2)

  // Dynamic Trust Score Thresholds
  tier1TrustScore        Int      @default(50)
  tier2TrustScore        Int      @default(70)
  tier3TrustScore        Int      @default(85)

  // Dynamic Spend Thresholds
  tier2LifetimeSpendINR  Decimal  @default(15000) @db.Decimal(10, 2)
  tier3LifetimeSpendINR  Decimal  @default(40000) @db.Decimal(10, 2)

  // Feature Flags
  learningHubEnabled       Boolean @default(false)
  maintenanceMode          Boolean @default(false)
  allowFirstOrderCod       Boolean @default(true)
  requirePhoneVerification Boolean @default(true)
  requireEmailVerification Boolean @default(false)
  codOtpRequired           Boolean @default(true)

  // ── Return Policy (Global Default) ───────
  returnWindowDays       Int      @default(7)
  exchangeWindowDays     Int      @default(14)
  returnPolicy           String?

  // ── Business Contact ──────────────────────
  supportEmail           String?
  supportPhone           String?
  supportHours           String?

  // ── Email Templates ───────────────────────
  orderConfirmationNote  String?
  shippingUpdateNote     String?

  // ── CMS Configuration ────────────────────
  /// Active hero template: 1 = Original, 2 = Editorial Slideshow, 3 = Split Spotlight, 4 = Editorial Window
  activeHeroTemplate          Int      @default(1)
  homepageBestSellersConfig   Json?
  homepageNewArrivalsConfig   Json?
  homepageMenswearConfig      Json?
  homepageWomenswearConfig    Json?
  homepageCategoriesConfig    Json?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("studio_settings")
}

// ─────────────────────────────────────────────
// Phase 7.1 — Checkout Engine & Shipping Models
// ─────────────────────────────────────────────

enum CheckoutSessionStatus {
  ACTIVE
  COMPLETED
  EXPIRED
  ABANDONED
}

enum CheckoutStep {
  INFORMATION
  SHIPPING
  PAYMENT
  CONFIRMATION
}

model ShippingZone {
  id        String   @id @default(cuid())
  name      String
  country   String   @default("IN")
  states    String[]
  pincodes  String[]
  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shippingMethods ShippingMethod[]

  @@map("shipping_zones")
}

model ShippingMethod {
  id               String        @id @default(cuid())
  shippingZoneId   String?
  name             String
  code             String        @unique // e.g. STANDARD, EXPRESS, STORE_PICKUP
  description      String?
  basePrice        Decimal       @db.Decimal(10, 2)
  minOrderForFree  Decimal?      @db.Decimal(10, 2)
  estDispatchDays  Int           @default(1)
  estDeliveryDays  Int           @default(4)
  cutoffTime       String        @default("14:00")
  shipWeekends     Boolean       @default(false)
  maxWeightKg      Decimal?      @db.Decimal(8, 2)
  priority         Int           @default(0)
  isEnabled        Boolean       @default(true)

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  shippingZone     ShippingZone? @relation(fields: [shippingZoneId], references: [id], onDelete: SetNull)
  checkoutSessions CheckoutSession[]

  @@index([isEnabled, priority(sort: Desc)])
  @@map("shipping_methods")
}

model CheckoutSession {
  id                String                @id @default(cuid())
  sessionToken      String                @unique
  userId            String?
  isGuest           Boolean               @default(false)
  customerEmail     String?
  customerPhone     String?
  customerName      String?

  shippingAddressId String?
  billingAddressId  String?
  shippingMethodId  String?
  couponCode        String?
  paymentMethod     PaymentMethod?        @default(ONLINE)

  step              CheckoutStep          @default(INFORMATION)
  pricingSnapshot   Json?
  status            CheckoutSessionStatus @default(ACTIVE)

  expiresAt         DateTime
  abandonedAt       DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  shippingMethod    ShippingMethod?       @relation(fields: [shippingMethodId], references: [id], onDelete: SetNull)

  @@index([sessionToken])
  @@index([userId])
  @@index([status])
  @@index([expiresAt])
  @@map("checkout_sessions")
}

// ─────────────────────────────────────────────
// Phase 7.2 — Promotions & Coupon Engine Models
// ─────────────────────────────────────────────

enum PromotionType {
  PERCENTAGE
  FIXED
  FREE_SHIPPING
  BUY_X_GET_Y
  CATEGORY_DISCOUNT
  COLLECTION_DISCOUNT
  PRODUCT_DISCOUNT
  FIRST_ORDER
  BIRTHDAY
  VIP
  FLASH_SALE
}

model Coupon {
  id                     String        @id @default(cuid())
  code                   String        @unique // Uppercase coupon code, e.g. WELCOME10
  title                  String
  description            String?
  type                   PromotionType @default(PERCENTAGE)
  discountValue          Decimal       @db.Decimal(10, 2) // Percentage or fixed amount
  maxDiscountAmount      Decimal?      @db.Decimal(10, 2) // Cap for percentage discounts
  minCartSubtotal        Decimal       @default(0) @db.Decimal(10, 2)
  
  usageLimit             Int?          // Global max redemptions
  perUserLimit           Int           @default(1)
  usedCount              Int           @default(0)

  startDate              DateTime
  endDate                DateTime?

  isStackable            Boolean       @default(false)
  isExclusive            Boolean       @default(false)
  isActive               Boolean       @default(true)

  eligibleCategories     String[]
  eligibleCollections    String[]
  eligibleProducts       String[]
  eligibleCustomerTiers  String[]

  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  deletedAt              DateTime?

  usages                 CouponUsage[]

  @@index([code])
  @@index([isActive, startDate, endDate])
  @@map("coupons")
}

model Promotion {
  id          String          @id @default(cuid())
  name        String
  description String?
  type        PromotionType
  priority    Int             @default(0)
  isActive    Boolean         @default(true)
  isAutomatic Boolean         @default(true)
  startDate   DateTime
  endDate     DateTime?

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  rules       PromotionRule[]

  @@index([isActive, isAutomatic, priority(sort: Desc)])
  @@map("promotions")
}

model PromotionRule {
  id          String    @id @default(cuid())
  promotionId String
  ruleName    String
  conditions  Json
  actions     Json

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@map("promotion_rules")
}

model CouponUsage {
  id             String   @id @default(cuid())
  couponId       String
  userId         String?
  orderId        String?
  cartId         String?
  discountAmount Decimal  @db.Decimal(10, 2)
  usedAt         DateTime @default(now())

  coupon         Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@index([couponId])
  @@index([userId])
  @@index([orderId])
  @@map("coupon_usages")
}

model WebhookEvent {
  id        String   @id @default(cuid())
  provider  String   @default("razorpay")
  eventId   String   @unique
  eventType String
  createdAt DateTime @default(now())

  @@map("webhook_events")
}

model PaymentWebhookLog {
  id          String   @id @default(cuid())
  provider    String   @default("razorpay")
  eventId     String?
  eventType   String
  payload     Json
  status      String   @default("SUCCESS")
  error       String?
  receivedAt  DateTime @default(now())
  processedAt DateTime @default(now())

  @@index([eventId])
  @@index([eventType])
  @@map("payment_webhook_logs")
}

model PaymentAuditLog {
  id          String   @id @default(cuid())
  paymentId   String
  oldStatus   String?
  newStatus   String
  reason      String?
  actorType   String   @default("SYSTEM")
  actorId     String?
  details     Json?
  createdAt   DateTime @default(now())

  @@index([paymentId])
  @@map("payment_audit_logs")
}

// ─────────────────────────────────────────────
// Returns Engine Models
// ─────────────────────────────────────────────

/// Enterprise return request with full lifecycle tracking
model ReturnRequest {
  id      String       @id @default(cuid())
  orderId String
  userId  String
  status  ReturnStatus @default(REQUESTED)

  // Reason
  reason ReturnReason
  notes  String?

  // Evidence — Cloudinary URLs
  mediaUrls String[]

  // Admin fields
  adminNote     String?
  inspectorNote String?
  disposition   ReturnDisposition?
  inspectedAt   DateTime?
  inspectedBy   String?

  // Refund fields
  refundType        RefundType @default(ORIGINAL_PAYMENT)
  requestedAmount   Decimal?   @db.Decimal(10, 2)
  approvedAmount    Decimal?   @db.Decimal(10, 2)
  restockingFee     Decimal    @default(0) @db.Decimal(10, 2)
  finalRefundAmount Decimal?   @db.Decimal(10, 2)
  refundId          String?
  razorpayRefundId  String?
  refundStatus      String?
  bankReferenceNumber String?
  refundInitiatedAt DateTime?
  refundProcessedAt DateTime?

  // Auto-approval metadata
  autoApproved    Boolean @default(false)
  autoApproveRule String?

  // Fraud detection
  fraudFlagged Boolean @default(false)
  fraudReason  String?

  // Shipping & Tracking fields
  courierPartner     String?
  trackingNumber     String?
  shipmentId         String?
  trackingUrl        String?
  pickupStatus       String?
  estimatedDelivery  DateTime?
  lastTrackingSync   DateTime?

  // Timeline
  requestedAt        DateTime  @default(now())
  approvedAt         DateTime?
  pickupScheduledAt  DateTime?
  pickedUpAt         DateTime?
  receivedAt         DateTime?
  resolvedAt         DateTime?
  updatedAt          DateTime  @updatedAt

  items    ReturnRequestItem[]
  timeline ReturnTimeline[]
  refunds  Refund[]

  order Order @relation(fields: [orderId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@index([orderId])
  @@index([userId])
  @@index([status])
  @@index([requestedAt(sort: Desc)])
  // Composite indexes for admin filtered list
  @@index([status, requestedAt(sort: Desc)])          // admin returns list filtered by status
  @@index([fraudFlagged, requestedAt(sort: Desc)])    // admin fraud-flagged filter
  @@map("return_requests")
}

/// Item-level lines for a return request with prorated refund amounts
model ReturnRequestItem {
  id              String @id @default(cuid())
  returnRequestId String
  orderItemId     String
  quantity        Int

  // Snapshot values at time of request
  unitPrice        Decimal @db.Decimal(10, 2)
  proratedDiscount Decimal @default(0) @db.Decimal(10, 2)
  refundableAmount Decimal @db.Decimal(10, 2)

  reason String?

  returnRequest ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItem     OrderItem     @relation(fields: [orderItemId], references: [id])

  @@map("return_request_items")
}

/// Customer-facing return lifecycle timeline (mirrors OrderStatusHistory)
model ReturnTimeline {
  id              String       @id @default(cuid())
  returnRequestId String
  status          ReturnStatus
  note            String?
  actorType       String
  actorId         String?
  createdAt       DateTime     @default(now())

  returnRequest ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)

  @@index([returnRequestId])
  @@map("return_timelines")
}

/// Exchange request — schema-only, UI deferred to Phase 2
model ExchangeRequest {
  id              String         @id @default(cuid())
  returnRequestId String         @unique
  status          ExchangeStatus @default(PENDING)

  replacementProductId String
  replacementVariantId String?
  replacementQuantity  Int

  inventoryReservedAt DateTime?
  replacementShippedAt DateTime?
  trackingNumber       String?

  notes     String?
  adminNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("exchange_requests")
}

// ─────────────────────────────────────────────
// Phase 10 — Bulk Product Import Engine
// ─────────────────────────────────────────────

enum ImportJobStatus {
  PENDING
  VALIDATING
  VALIDATED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum ImportRowStatus {
  SUCCESS
  FAILED
  SKIPPED
  UPDATED
}

enum DuplicateStrategy {
  SKIP
  UPDATE
  REPLACE
  AUTO_RENAME
}

enum ImportMode {
  CREATE_ONLY
  UPDATE_EXISTING
  UPSERT
}

/// Tracks a single bulk import session end-to-end
model ImportJob {
  id               String            @id @default(cuid())
  userId           String
  fileName         String
  fileSize         Int               @default(0)
  fileType         String            @default("csv")

  status           ImportJobStatus   @default(PENDING)
  importMode       ImportMode        @default(CREATE_ONLY)
  duplicateStrategy DuplicateStrategy @default(SKIP)
  validationOnly   Boolean           @default(false)

  totalRows        Int               @default(0)
  processedRows    Int               @default(0)
  createdProducts  Int               @default(0)
  updatedProducts  Int               @default(0)
  failedProducts   Int               @default(0)
  skippedProducts  Int               @default(0)
  categoriesCreated Int              @default(0)
  imagesAdded      Int               @default(0)
  variantsCreated  Int               @default(0)

  durationMs       Int?
  errorSummary     String?

  startedAt        DateTime?
  completedAt      DateTime?
  cancelledAt      DateTime?
  cancelledBy      String?

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  rows             ImportJobRow[]

  @@index([userId])
  @@index([status])
  @@map("import_jobs")
}

/// Per-row execution record for an ImportJob
model ImportJobRow {
  id           String          @id @default(cuid())
  importJobId  String
  rowNumber    Int
  sku          String?
  productName  String?
  status       ImportRowStatus @default(FAILED)
  errorMessage String?
  productId    String?
  payload      Json

  createdAt    DateTime        @default(now())

  importJob    ImportJob       @relation(fields: [importJobId], references: [id], onDelete: Cascade)

  @@index([importJobId])
  @@index([status])
  @@map("import_job_rows")
}

/// Dedicated Refund model supporting multiple partial refunds per payment/order
model Refund {
  id                  String       @id @default(cuid())
  paymentId           String
  returnRequestId     String?
  orderId             String
  provider            String       @default("RAZORPAY")
  providerRefundId    String?      @unique
  status              RefundStatus @default(INITIATED)
  amount              Decimal      @db.Decimal(10, 2)
  currency            String       @default("INR")
  reason              String?
  speed               String?      @default("normal")
  bankReferenceNumber String?
  providerPayload     Json?
  idempotencyKey      String?      @unique
  initiatedAt         DateTime     @default(now())
  processedAt         DateTime?
  failedAt            DateTime?
  failureReason       String?
  gatewayErrorCode    String?
  gatewayErrorDesc    String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  // Manual Override Fields
  manualOverride      Boolean   @default(false)
  overrideReason      String?
  overriddenBy        String?
  overriddenAt        DateTime?

  payment       Payment        @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  returnRequest ReturnRequest? @relation(fields: [returnRequestId], references: [id])
  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  timeline      RefundTimeline[]

  @@index([paymentId])
  @@index([returnRequestId])
  @@index([orderId])
  @@index([providerRefundId])
  @@map("refunds")
}

/// Webhook idempotency registry to prevent duplicate processing
model ProcessedWebhook {
  id          String   @id @default(cuid())
  eventId     String   @unique
  eventType   String
  receivedAt  DateTime @default(now())
  processedAt DateTime @default(now())
  payloadHash String?

  @@index([eventId])
  @@map("processed_webhooks")
}

/// Granular step tracking for individual refund attempts
model RefundTimeline {
  id          String       @id @default(cuid())
  refundId    String
  status      RefundStatus
  title       String
  description String?
  source      String       @default("SYSTEM") // SYSTEM, GATEWAY, ADMIN, WEBHOOK
  metadata    Json?
  createdAt   DateTime     @default(now())

  refund Refund @relation(fields: [refundId], references: [id], onDelete: Cascade)

  @@index([refundId])
  @@map("refund_timelines")
}

/// Cluster-safe job synchronization locks
model CronJobLock {
  id        String   @id
  lockedAt  DateTime @default(now())
  lockedBy  String
  expiresAt DateTime

  @@map("cron_job_locks")
}

